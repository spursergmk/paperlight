{
  "name": "paperlight",
  "productName": "Paperlight",
  "private": true,
  "version": "1.0.1",
  "description": "Paperlight：本地优先的知识工作台。像 IDE 一样浏览文件夹、多标签阅读 PDF/EPUB/TXT/Markdown，右侧查询义项、追问、记笔记；笔记空间把义项与笔记归档进 vault，对话空间基于所选 vault 内容严格 grounded 地挖掘知识。",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "app": "npm run build && electron .",
    "app:dev": "node scripts/app-dev.mjs",
    "smoke": "npm run build && PAPERLIGHT_SMOKE=1 electron .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run build && npm test && node scripts/check-node-files.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dist:mac": "npm run build && electron-builder --mac && node scripts/expose-mac-app.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64",
    "dist": "npm run build && electron-builder --mac && electron-builder --win && electron-builder --linux AppImage --x64 && node scripts/expose-mac-app.mjs",
    "syntax": "node scripts/check-node-files.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  },
  "author": "spursergmk",
  "repository": {
    "type": "git",
    "url": "https://github.com/spursergmk/paperlight.git"
  },
  "desktopName": "paperlight.desktop"
}
